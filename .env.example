# Platform: polymarket atau kalshi
PLATFORM=polymarket

# Safety — jangan ubah ke false sampai siap live
DRY_RUN=true

# Manajemen risiko
MAX_POSITIONS=3
USDC_PER_TRADE=10
MIN_BALANCE_USDC=5

# Filter Seeker
MIN_VOLUME=5000
MIN_EDGE=0.05
MAX_DAYS_RESOLUTION=7
MIN_CREDIBILITY=70

# Monitor thresholds
SELL_PROFIT=0.15
CUT_LOSS=-0.30

# Interval (detik)
SEEKER_INTERVAL=1800
MONITOR_INTERVAL=300

# API Keys
OPENROUTER_API_KEY=sk-or-...
POLYMARKET_PRIVATE_KEY=0x...
KALSHI_API_KEY=

# Model LLM via OpenRouter
LLM_MODEL=anthropic/claude-3-5-haiku

# News feed — daftar gratis di newsapi.org atau gnews.io
NEWSAPI_KEY=
GNEWS_KEY=

# Telegram — buat bot via @BotFather, chat_id via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
